# ─── Dependencies ───────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Next.js / build output ─────────────────────────────────────
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# ─── Generated Prisma client ────────────────────────────────────
# (regenerated by `prisma generate` / postinstall)
app/src/generated/

# ─── Local database (created by `npm run db:migrate` + `db:seed`) ─
*.db
*.db-journal
*.sqlite
*.sqlite3

# ─── Environment files ──────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Logs & debug ───────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── Testing ────────────────────────────────────────────────────
/coverage

# ─── OS / editor / misc ─────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
.vercel
