DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/campuseats?sslmode=require"
# Optional Supabase/Vercel integration variables. The app prefers the pooled
# URL at runtime and the non-pooling URL for Prisma CLI operations.
# POSTGRES_PRISMA_URL="postgresql://...pooled connection..."
# POSTGRES_URL_NON_POOLING="postgresql://...direct connection..."
JWT_SECRET="campuseats-jwt-secret-change-in-production"
JWT_EXPIRES_IN="7d"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
MOCK_OTP_CODE="123456"
NODE_ENV="development"
